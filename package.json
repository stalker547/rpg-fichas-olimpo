{
  "name": "rpg-fichas",
  "version": "1.0.18",
  "description": "Gerenciador local de fichas de RPG",
  "main": "main.js",
  "author": "Sergio",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --win nsis",
    "android:sync": "node scripts/prepare-android.cjs && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.sergio.rpgfichas",
    "productName": "RPG Fichas",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "stalker547",
      "repo": "rpg-fichas-olimpo",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "online-main.js",
      "online-client.js",
      "merge-character.js",
      "appearance-style.js",
      "storage.js",
      "ocr-table.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/ocr/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RPG-Fichas-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RPG Fichas"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "regenerator-runtime": "0.13.11",
    "sharp": "^0.34.5",
    "tesseract.js": "^6.0.1"
  }
}
